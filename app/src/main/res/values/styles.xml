<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EmuAll" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="colorAccent">@color/accent</item>
    </style>
    <style name="EmuButton">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
    <style name="EmuButton.Small" parent="EmuButton">
        <item name="android:layout_width">54dp</item><item name="android:layout_height">38dp</item><item name="android:layout_marginStart">4dp</item><item name="android:textSize">10sp</item>
    </style>
    <style name="EmuButton.Toolbar" parent="EmuButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">38dp</item><item name="android:layout_weight">1</item><item name="android:layout_marginHorizontal">2dp</item><item name="android:textSize">10sp</item><item name="android:paddingHorizontal">0dp</item>
    </style>
    <style name="EmuButton.Pad" parent="EmuButton">
        <item name="android:layout_width">52dp</item><item name="android:layout_height">52dp</item><item name="android:textSize">18sp</item>
    </style>
    <style name="EmuButton.Shoulder" parent="EmuButton">
        <item name="android:layout_width">72dp</item><item name="android:layout_height">42dp</item><item name="android:layout_margin">5dp</item>
    </style>
    <style name="EmuButton.Round" parent="EmuButton">
        <item name="android:layout_width">64dp</item><item name="android:layout_height">64dp</item><item name="android:textSize">18sp</item>
    </style>
    <style name="EmuButton.PlayStation" parent="EmuButton">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/button_playstation</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="EmuButton.Center" parent="EmuButton">
        <item name="android:layout_width">74dp</item><item name="android:layout_height">38dp</item><item name="android:textSize">11sp</item>
    </style>
    <style name="EmuButton.CPad" parent="EmuButton">
        <item name="android:layout_width">34dp</item><item name="android:layout_height">34dp</item><item name="android:textSize">7sp</item><item name="android:padding">0dp</item>
    </style>
</resources>
