<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#344039" />
            <stroke android:width="2dp" android:color="#9BE33A" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A201D" />
            <stroke android:width="1dp" android:color="#657169" />
        </shape>
    </item>
</selector>
